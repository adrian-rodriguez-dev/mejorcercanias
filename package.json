{
  "name": "mejorcercanias",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "spec": "openspec",
    "check": "npm run format:check && npm run check:architecture && npm test && npm run build && openspec validate --all --strict",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"build/*.{ts,js}\" \"worker/*.mjs\" \"scripts/*.mjs\" \"docs/**/*.md\" \"*.{json,ts,md}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"build/*.{ts,js}\" \"worker/*.mjs\" \"scripts/*.mjs\" \"docs/**/*.md\" \"*.{json,ts,md}\" \".github/workflows/*.yml\"",
    "test:worker": "node --test worker/worker.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fission-ai/openspec": "^1.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.1.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
